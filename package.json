{
  "name": "launchdarkly-toolbar-monorepo",
  "private": true,
  "description": "Monorepo for LaunchDarkly Toolbar and Demo App",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "demo": "pnpm --filter launchdarkly-toolbar-demo dev",
    "demo:mock": "pnpm --filter launchdarkly-toolbar-demo dev:mock",
    "demo:build": "pnpm --filter launchdarkly-toolbar-demo build",
    "demo:build:mock": "pnpm --filter launchdarkly-toolbar-demo build:mock",
    "dev": "tsx scripts/dev-with-hot-reload.ts",
    "dev:toolbar": "pnpm --filter @launchdarkly/toolbar dev",
    "dev:link": "./scripts/sdk-symlinks/setup-local-links.sh",
    "dev:server": "pnpm --filter mock-server start",
    "dev:status": "./scripts/sdk-symlinks/dev-status.sh",
    "dev:unlink": "./scripts/sdk-symlinks/remove-local-links.sh",
    "dev:watch": "./scripts/sdk-symlinks/dev-watch.sh",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "lint": "pnpm -r lint",
    "storybook": "pnpm --filter @launchdarkly/toolbar storybook",
    "build:storybook": "pnpm --filter @launchdarkly/toolbar build:storybook",
    "test": "pnpm --filter @launchdarkly/toolbar test",
    "test:e2e:ci": "TEST_ENV=ci playwright test --config=./e2e/playwright.config.ts",
    "test:e2e:local": "TEST_ENV=local playwright test --config=./e2e/playwright.config.ts",
    "test:e2e:local:ui": "TEST_ENV=local playwright test --ui --config=./e2e/playwright.config.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.1",
    "@types/node": "^25.3.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "lodash": "4.18.0",
    "prettier": "^3.8.1",
    "qs": "6.16.0",
    "storybook": "^10.2.19",
    "storybook-addon-rslib": "^3.2.2",
    "storybook-react-rsbuild": "^3.2.2",
    "tsx": "^4.21.0",
    "webpack": "5.109.2"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@>=4": "^5.0.9",
      "fast-uri": "^3.1.6",
      "flatted": "^3.4.2",
      "immutable@4": "^4.3.9",
      "minimatch@3": "^3.1.3",
      "minimatch@9": "^9.0.7",
      "minimatch@10": "^10.2.3",
      "path-to-regexp@8": "^8.4.0",
      "postcss@8": "^8.5.18",
      "proxy-addr": "^2.0.8",
      "rollup@4": "^4.59.0",
      "ws@8": "^8.21.0"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md,yml,yaml}": "prettier --write"
  }
}
